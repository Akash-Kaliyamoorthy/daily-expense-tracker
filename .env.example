# Copy to .env in the project root for local development: cp .env.example .env

# PostgreSQL connection string (local example).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/expense_tracker

# Used by `npm test` only. Must be a SEPARATE database: tests delete all users in it.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/expense_tracker_test

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# At least 32 characters are required in production.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

NODE_ENV=development
PORT=5000

# Allowed browser origins for CORS, comma separated. In development the Vite server runs here.
CLIENT_URL=http://localhost:5173

# Optional
APP_TIMEZONE=Asia/Kolkata
# JWT_EXPIRES_DAYS=7
# DATABASE_SSL=false
